---
layout: default
---
{% comment %}
  Editorial homepage. Content lives in _pages/about.md:
  - the page body is the large intro statement
  - front matter `facts:` fills the columns beside the photo
  - `research:` controls the "Current research" section (pulls from _projects)
  - `announcements:` controls the "Recently" list (pulls from _news)
{% endcomment %}
<div class="post ed-home">
  <h1 class="sr-only">
    {% if site.title == 'blank' %}{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}{% else %}{{ site.title }}{% endif %}
  </h1>

  <div class="ed-intro">{{ content }}</div>

  <hr class="ed-rule">

  <section class="ed-profile" aria-label="Profile">
    {% if page.profile and page.profile.image %}
      <div class="ed-photo">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="280px" alt=page.profile.alt
          cache_bust=true
        %}
      </div>
    {% endif %}

    {% if page.facts %}
      <div class="ed-facts">
        {% for column in page.facts %}
          <div>
            <h2>{{ column.heading }}</h2>
            <ul>
              {% for item in column.items %}
                <li{% unless item.title %} class="ed-sub"{% endunless %}>
                  {% if item.title %}<span class="ed-fact-title">{{ item.title }}</span>{% endif %}
                  {% if item.url %}
                    <a class="ed-fact-detail" href="{{ item.url | relative_url }}">{{ item.detail }}</a>
                  {% elsif item.detail %}
                    <span class="ed-fact-detail">{{ item.detail }}</span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </section>

  {% if page.research and page.research.enabled %}
    {% assign sorted_projects = site.projects | sort: 'importance' %}
    <section class="ed-section">
      <div class="ed-section-head">
        <h2>{{ page.research.heading | default: 'Current research' }}</h2>
        <a href="{{ '/projects/' | relative_url }}">All projects →</a>
      </div>
      <div class="ed-research">
        {% for project in sorted_projects limit: page.research.limit %}
          <article>
            <span class="ed-label">{{ project.label | default: project.category }}</span>
            <h3>
              <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
            </h3>
            <p>{{ project.description }}</p>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if page.announcements and page.announcements.enabled and site.news != blank %}
    {% assign news = site.news | reverse %}
    <section class="ed-section">
      <div class="ed-section-head">
        <h2>Recently</h2>
        <a href="{{ '/news/' | relative_url }}">All news →</a>
      </div>
      <ul class="ed-news">
        {% for item in news limit: page.announcements.limit %}
          <li>
            <span class="ed-news-date">{{ item.date | date: '%b %Y' }}</span>
            <span class="ed-news-text">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </span>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
</div>
