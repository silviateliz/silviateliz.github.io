<!-- Paper: SVG filter that gives the highlighter stroke its wobble.
     Include once per page, just before </body>. -->
<svg width="0" height="0" aria-hidden="true" style="position: absolute">
  <filter id="pm-marker-wobble" x="-8%" y="-30%" width="120%" height="170%">
    <feTurbulence type="fractalNoise" baseFrequency="0.006 0.02" numOctaves="1" seed="4" result="n" />
    <feDisplacementMap in="SourceGraphic" in2="n" scale="5" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>
